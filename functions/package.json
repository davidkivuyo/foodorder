{
  "name": "campusbite-functions",
  "description": "CampusBite Cloud Functions - Strike engine, order status, image management",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.9.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase-functions-test": "^3.4.0",
    "firebase-tools": "^15.24.0"
  },
  "scripts": {
    "test:no-show:integration": "cd .. && firebase emulators:exec --only firestore --project demo-foodorder \"node --test functions/test/no_show_integration.test.js\"",
    "test:cancellation:integration": "cd .. && firebase emulators:exec --only firestore --project demo-foodorder \"node --test functions/test/order_cancellation_integration.test.js\"",
    "test:reliability:integration": "cd .. && firebase emulators:exec --only firestore --project demo-foodorder \"node --test functions/test/pickup_reliability_integration.test.js\"",
    "test:phase-e:integration": "cd .. && firebase emulators:exec --only firestore --project demo-foodorder \"node --test functions/test/phase_e_restriction_integration.test.js\"",
    "test:cafe-scoping:integration": "cd .. && firebase emulators:exec --only firestore --project demo-foodorder \"node --test functions/test/order_cafe_scoping_integration.test.js\"",
    "test:excuse:integration": "cd .. && firebase emulators:exec --only firestore --project demo-foodorder \"node --test functions/test/excuse_no_show_integration.test.js\""
  }
}
